import requests
import json
import pandas as pd

API_KEY = "YOUR_EIA_KEY"
CENSUS_KEY = "YOUR_CENSUS_KEY"

# --- Get EIA plant data ---
eia_df = pd.DataFrame(...)  # your df_plants from Step 3

# --- Get FIPS crosswalk from Census ---
census_url = "https://api.census.gov/data/2020/acs/acs5"
census_resp = requests.get(census_url, params={
    "get": "NAME,GEO_ID",
    "for": "county:*",
    "key": CENSUS_KEY
})
census_data = census_resp.json()
df_fips = pd.DataFrame(census_data[1:], columns=census_data[0])

# Extract state FIPS and county FIPS from GEO_ID (format: 0500000US{state}{county})
df_fips["state_fips"] = df_fips["GEO_ID"].str[-5:-3]
df_fips["county_fips"] = df_fips["GEO_ID"].str[-3:]
df_fips["full_fips"] = df_fips["GEO_ID"].str[-5:]

# Merge EIA plant data with FIPS on state + county name
df_merged = eia_df.merge(
    df_fips[["NAME", "full_fips", "state", "county"]],
    left_on=["stateid", "county"],
    right_on=["state", "county"],
    how="left"
)

print(df_merged[["plantid", "plant_name", "stateid", "county", "full_fips",
                  "operating-year", "nameplate-capacity-mw"]].head(10))
end
