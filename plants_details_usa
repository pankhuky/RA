        "operating-year",     # Year plant became operational (establishment year)
        "county",             # County name
        "stateid",            # State abbreviation
        "latitude",
        "longitude",
        "status"              # Operating status (OP = operating)
    ],
    "facets": {
        "energy_source_code": ["NUC"],
        "status": ["OP"]       # Only currently operating plants
    },
    "sort": [{"column": "period", "direction": "desc"}],
    "offset": 0,
    "length": 5000
}

response = requests.get(
    EIA_860_URL,
    params={"api_key": API_KEY},
    headers={"X-Params": json.dumps(header_params)}
)

result = response.json()

if "response" not in result:
    print("ERROR:", result)
else:
    df_plants = pd.DataFrame(result["response"]["data"])

    # Keep most relevant columns (rename for clarity)
    print(df_plants.columns.tolist())  # first inspect what came back
end

