def fetch_and_clean(
    api_key:       str       = None,
    status_filter: list[str] = None,
) -> pd.DataFrame:
    """
    Fetch data from EIA API and clean it.  Populates global DF.

    Parameters
    ----------
    api_key       : EIA key (defaults to EIA_API_KEY env var).
    status_filter : e.g. ['OP'] for operating generators only.

    Returns
    -------
    pd.DataFrame : Cleaned generator data (also stored in module-level DF).

    Stata usage
    -----------
        python: import eia_plants_stata as eia
        python: eia.fetch_and_clean(status_filter=["OP"])
    """
    global DF, EIA_API_KEY

    key = (api_key or EIA_API_KEY).strip()
    if not key or key == "YOUR_API_KEY":
        raise ValueError(
            "Set your API key first:\n"
            "  python: import os\n"
            "  python: os.environ['EIA_API_KEY'] = 'your_real_key'\n"
            "  python: import eia_plants_stata as eia\n"
            "  python: eia.EIA_API_KEY = 'your_real_key'"
        )

    print("\n[1/2] Fetching data from EIA API …")
    df_raw = fetch_raw(api_key=key, status_filter=status_filter)
    print(f"      {len(df_raw):,} raw records retrieved.")

    print("\n[2/2] Cleaning data …")
    DF = clean(df_raw)
    print(f"      {len(DF):,} unique generators after deduplication.")

    return DF


def build_summaries(print_tables: bool = True) -> dict:
    """
    Build state / fuel / tech summary tables and trend data.
    Populates globals BY_STATE, BY_FUEL, BY_TECH, TREND.

    Stata usage
    -----------
        python: eia.build_summaries()
    """
    global DF, BY_STATE, BY_FUEL, BY_TECH, TREND

    if DF is None:
        print("[error] Run fetch_and_clean() first.")
        return {}

    BY_STATE = _state_summary(DF)
    BY_FUEL  = _fuel_summary(DF)
    BY_TECH  = _tech_summary(DF)
    TREND    = _capacity_trend(DF)

    if print_tables:
        _print_summaries(BY_STATE, BY_FUEL, BY_TECH)

    return {"by_state": BY_STATE, "by_fuel": BY_FUEL,
            "by_tech": BY_TECH, "trend": TREND}


def make_charts(include_plotly: bool = True) -> None:
    """
    Generate all PNG charts (always) and HTML interactive charts (if plotly
    is installed and include_plotly=True).

    Output folder: eia_output/  next to this script.

    Stata usage
    -----------
        python: eia.make_charts()
    """
    global DF, BY_STATE, BY_FUEL, BY_TECH, TREND

    if DF is None:
        print("[error] Run fetch_and_clean() and build_summaries() first.")
        return

    if BY_FUEL is None:
        build_summaries(print_tables=False)

    print("\n  Generating PNG charts …")
    _chart_fuel_bar(BY_FUEL)
    _chart_fuel_pie(BY_FUEL)
    _chart_state_bar(BY_STATE)
    _chart_top_plants(DF)
    _chart_heatmap(DF)
    if TREND is not None and not TREND.empty:
        _chart_trend(TREND)
        _chart_stacked(TREND)

    if include_plotly:
        print("\n  Generating interactive HTML charts …")
        _plotly_charts(BY_FUEL, BY_STATE, TREND)


def run_full_pipeline(
    api_key:       str       = None,
    status_filter: list[str] = None,
    push_stata:    bool      = True,
) -> None:
    """
    Run the complete pipeline in one call:
      fetch → clean → summaries → charts → CSV → push to Stata

    Parameters
    ----------
    api_key       : EIA API key (or set EIA_API_KEY env var).
    status_filter : e.g. ['OP'].  None = all statuses.
    push_stata    : If True and running inside Stata, load data into Stata.

    Stata usage
    -----------
        python script "eia_plants_stata.py"   <- runs main() automatically

      Or step by step:
        python: import eia_plants_stata as eia
        python: eia.run_full_pipeline(status_filter=["OP"])
    """
    div = "=" * 72
    print(f"\n{div}")
    print("  US Power Plants – EIA Data Pipeline")
    print(f"{div}\n")

    try:
        fetch_and_clean(api_key=api_key, status_filter=status_filter)
        build_summaries()
        make_charts()
        save_csvs()
        if push_stata:
            push_to_stata()
    except Exception as exc:
        print(f"\n[FATAL ERROR] {exc}")
        traceback.print_exc()
        return

    print(f"\n{div}")
    print(f"  Done!  Outputs in: {OUTPUT_DIR}")
    print(f"{div}\n")
    for f in sorted(os.listdir(OUTPUT_DIR)):
        sz = os.path.getsize(os.path.join(OUTPUT_DIR, f))
        print(f"  {f:<48}  {sz:>10,} bytes")


