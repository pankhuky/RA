import requests
import json
import pandas as pd

API_KEY = "YOUR_API_KEY"
EIA_URL = "https://api.eia.gov/v2/electricity/operating-generator-capacity/data/"

header_params = {
    "frequency": "annual",
    "data": [
        "summer-capacity",        # Capacity in MW
        "nameplate-capacity-mw",  # Nameplate capacity
        "operating-year",         # Establishment / operating year
        "county",                 # County name
        "latitude",
        "longitude"
    ],
    "facets": {
        "energy_source_code": ["NUC"]  # Nuclear only
    },
    "sort": [{"column": "operating-year", "direction": "asc"}],
    "offset": 0,
    "length": 5000
}

response = requests.get(
    EIA_URL,
    params={"api_key": API_KEY},
    headers={"X-Params": json.dumps(header_params)}
)

result = response.json()

if "response" not in result:
    print("ERROR:", result)
else:
    df = pd.DataFrame(result["response"]["data"])
    print(f"Total records: {result['response']['total']}")
    print(df.columns.tolist())   # <-- Print all returned columns
    print(df.head())
end

