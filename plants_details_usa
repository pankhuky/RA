# 9.  ENTRY POINT
#     When run via  `python script "eia_plants_stata.py"`  Stata executes
#     the module top-to-bottom, which triggers main() here.
# ═════════════════════════════════════════════════════════════════════════════

def main():
    run_full_pipeline(status_filter=["OP"], push_stata=True)


if __name__ == "__main__":
    main()

