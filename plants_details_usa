# 6.  STATA INTEGRATION  (push cleaned DataFrame → Stata memory)
# ═════════════════════════════════════════════════════════════════════════════

def push_to_stata() -> None:
    """
    Load the cleaned DataFrame into Stata's active dataset.

    Call this after fetch_and_clean().  In Stata you can then run any
    Stata command on the data immediately.

    Example Stata session:
        python: push_to_stata()
        summarize nameplate_capacity_mw
        tabulate fuel_group
        histogram nameplate_capacity_mw, freq
    """
    global DF
    if DF is None:
        print("[error] No data loaded. Run fetch_and_clean() first.")
        return
    if not IN_STATA:
        print("[warn] Not running inside Stata – skipping push_to_stata().")
        print("       The cleaned DataFrame is available as eia_plants_stata.DF")
        return

    df = DF.copy()

    # Stata variable names: lowercase, no hyphens, max 32 chars
    df.columns = (
        df.columns.str.lower()
                  .str.replace(r"[^a-z0-9_]", "_", regex=True)
                  .str[:32]
    )

    # Drop columns Stata can't handle (datetime objects → convert to string)
    for col in df.select_dtypes(include="datetime").columns:
        df[col] = df[col].dt.strftime("%Y-%m").fillna("")

    # Stata only handles str, float64, int64 cleanly
    for col in df.columns:
        if df[col].dtype == object:
            df[col] = df[col].fillna("").astype(str)
        elif pd.api.types.is_integer_dtype(df[col]):
            df[col] = pd.to_numeric(df[col], errors="coerce").fillna(0).astype(float)
        else:
            df[col] = pd.to_numeric(df[col], errors="coerce")

    # Clear Stata memory and load
    sfi.Data.setObsTotal(len(df))

    for col in df.columns:
        if df[col].dtype == object:
            sfi.Data.addVarStr(col, 244)
        else:
            sfi.Data.addVarDouble(col)

    for col in df.columns:
        vals = df[col].tolist()
        for i, v in enumerate(vals):
            sfi.Data.storeAt(col, i, v)

    # Variable labels
    label_map = {
        "nameplate_capacity_mw":          "Nameplate capacity (MW)",
        "net_summer_capacity_mw":         "Net summer capacity (MW)",
        "net_winter_capacity_mw":         "Net winter capacity (MW)",
        "operating_year":                 "Year generator came online",
        "retirement_year":                "Planned retirement year",
        "fuel_group":                     "Broad fuel category",
        "fuel_label":                     "Specific fuel label",
        "stateid":                        "State abbreviation",
        "county":                         "County",
        "latitude":                       "Latitude",
        "longitude":                      "Longitude",
        "period_year":                    "Data snapshot year",
    }
    for var, lbl in label_map.items():
        if var in df.columns:
            try:
                sfi.Data.setVarLabel(var, lbl)
            except Exception:
                pass

    print(f"  Pushed {len(df):,} observations × {len(df.columns)} variables to Stata.")
    print("  Type  'describe'  or  'summarize'  in Stata to inspect the data.")


# ═════════════════════════════════════════════════════════════════════════════
# 7.  SAVE CSV OUTPUTS
# ═════════════════════════════════════════════════════════════════════════════

def save_csvs() -> None:
    """Write all summary tables and the cleaned generator file to CSV."""
    global DF, BY_STATE, BY_FUEL, BY_TECH, TREND
    if DF is None:
        print("[error] No data. Run fetch_and_clean() first.")
        return

    paths = {
        "generators_clean.csv":          DF,
        "summary_by_state.csv":          BY_STATE,
        "summary_by_fuel.csv":           BY_FUEL,
        "summary_by_technology.csv":     BY_TECH,
        "trend_capacity_additions.csv":  TREND,
    }
    for fname, frame in paths.items():
        if frame is not None and not (
            isinstance(frame, pd.DataFrame) and frame.empty
        ):
            p = os.path.join(OUTPUT_DIR, fname)
            frame.to_csv(p, index=False)
            print(f"  Saved → {p}")


